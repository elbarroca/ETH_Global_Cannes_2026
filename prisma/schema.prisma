generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id
  walletAddress      String        @unique @map("wallet_address")
  proxyWallet        Json          @default("{}") @map("proxy_wallet")
  telegram           Json          @default("{\"chatId\": null, \"username\": null, \"verified\": false, \"notifyPreference\": \"every_cycle\"}")
  agent              Json          @default("{\"active\": false, \"goal\": \"\", \"cycleCount\": 0, \"cyclesRemaining\": 0, \"lastCycleAt\": null, \"lastCycleId\": 0, \"riskProfile\": \"balanced\", \"maxTradePercent\": 10}")
  fund               Json          @default("{\"currentNav\": 0, \"depositedUsdc\": 0, \"htsShareBalance\": 0}")
  inftTokenId        Int?          @map("inft_token_id")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  hot_wallet_index   Int?
  hot_wallet_address String?
  actions            AgentAction[]
  cycles             Cycle[]
  hiredAgents        UserHiredAgent[]
  pendingCycles      PendingCycle[]
  chatMessages       ChatMessage[]

  @@index([walletAddress], map: "idx_users_wallet")
  @@map("users")
}

model Cycle {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id")
  cycleNumber      Int           @map("cycle_number")
  goal             String?       @db.Text
  payments         Json?
  specialists      Json          @default("[]")
  alphaAction      String?       @map("alpha_action")
  alphaPct         Int?          @map("alpha_pct")
  alphaAttestation String?       @map("alpha_attestation")
  riskChallenge    String?       @map("risk_challenge")
  riskMaxPct       Int?          @map("risk_max_pct")
  riskAttestation  String?       @map("risk_attestation")
  execAction       String?       @map("exec_action")
  execPct          Int?          @map("exec_pct")
  execStopLoss     String?       @map("exec_stop_loss")
  execAttestation  String?       @map("exec_attestation")
  alphaReasoning   String?       @map("alpha_reasoning")
  riskReasoning    String?       @map("risk_reasoning")
  execReasoning    String?       @map("exec_reasoning")
  decision         String?
  asset            String?
  decisionPct      Int?          @map("decision_pct")
  hcsSeqNum        Int?          @map("hcs_seq_num")
  hashscanUrl      String?       @map("hashscan_url")
  storageHash      String?       @map("storage_hash")
  totalCostUsd     Float?        @map("total_cost_usd")
  navAfter         Float?        @map("nav_after")
  swapTxHash       String?       @map("swap_tx_hash")
  swapChain        String?       @default("arc-testnet") @map("swap_chain")
  swapAmount       String?       @map("swap_amount")
  swapAssetIn      String?       @map("swap_asset_in")
  swapAssetOut     String?       @map("swap_asset_out")
  swapExplorerUrl  String?       @map("swap_explorer_url")
  debateDurationMs Int?          @map("debate_duration_ms")
  debateTurns      Int?          @map("debate_turns")
  // Cached CycleNarrative JSON (synthesizeCycleNarrative output). Populated
  // by logCycleRecord on commit; read directly by enrichCycleRow so the
  // dashboard doesn't re-synthesize on every fetch. The canonical copy still
  // lives inside the 0G rich record at `storage_hash`.
  narrative        Json?         @map("narrative")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actions          AgentAction[]
  transcripts      DebateTranscript[]
  user             User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, cycleNumber], map: "idx_cycles_user_cycle")
  @@map("cycles")
}

model AgentAction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id")
  cycleId         String?  @map("cycle_id") @db.Uuid
  actionType      String   @map("action_type")
  agentName       String?  @map("agent_name")
  status          String   @default("success")
  payload         Json?
  attestationHash String?  @map("attestation_hash")
  teeVerified     Boolean? @map("tee_verified")
  paymentAmount   String?  @map("payment_amount")
  paymentNetwork  String?  @map("payment_network")
  paymentTxHash   String?  @map("payment_tx_hash")
  durationMs      Int?     @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle           Cycle?   @relation(fields: [cycleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt], map: "idx_agent_actions_created")
  @@index([cycleId], map: "idx_agent_actions_cycle")
  @@index([userId, actionType], map: "idx_agent_actions_user_type")
  @@map("agent_actions")
}

model MarketplaceAgent {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String            @unique
  endpoint     String
  price        String            @default("$0.001")
  tags         String[]          @default([])
  reputation   Int               @default(500)
  totalHires   Int               @default(0) @map("total_hires")
  correctCalls Int               @default(0) @map("correct_calls")
  inftTokenId  Int?              @map("inft_token_id")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  hiredBy      UserHiredAgent[]

  specialistType  String?           @default("analysis") @map("specialist_type")
  dataSources     String[]          @default([]) @map("data_sources")
  openclawAgentId String?           @map("openclaw_agent_id")
  walletAddress   String?           @map("wallet_address")
  storageRootHash String?           @map("storage_root_hash")
  storageUri      String?           @map("storage_uri")
  mintTxHash      String?           @map("mint_tx_hash")

  // User-created agents (dashboard "Create Your Own Agent" flow) — the
  // description is what the user typed, `instructions` is the SOUL+IDENTITY
  // markdown generated by 0G Compute, `tools` is the checked capabilities,
  // and `createdBy` is the creator's wallet address. All nullable so existing
  // built-in specialists are unaffected.
  description  String?
  instructions String?
  tools        String[] @default([])
  createdBy    String?  @map("created_by")

  @@map("marketplace_agents")
}

// Canonical history of user feedback on specialists. Every like / dislike /
// verify action produces a row — the `MarketplaceAgent.reputation` column is
// the derived ELO value after applying these ratings in order. The unique
// `(userId, agentName, cycleId)` constraint enforces one rating per user per
// specialist per hunt cycle; flipping a vote upserts the existing row.
//
// `hcsSeqNum` / `hcsTopicId` are populated after the rate API awaits a
// `logSwarmEvent({ ev: "rating", ... })` call — together with the
// `reputationBefore`/`reputationAfter` snapshot, this row is the point-in-time
// on-chain proof that judges can verify on Hashscan. If HCS is down the row
// still commits with those columns null so the UX never blocks on Hedera.
model AgentRating {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id")
  agentName         String   @map("agent_name")
  cycleId           Int      @map("cycle_id")
  kind              String   // "like" | "dislike" | "verify"
  reputationBefore  Int      @map("reputation_before")
  reputationAfter   Int      @map("reputation_after")
  hcsSeqNum         Int?     @map("hcs_seq_num")
  hcsTopicId        String?  @map("hcs_topic_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, agentName, cycleId], map: "uniq_user_agent_cycle_rating")
  @@index([agentName, createdAt], map: "idx_agent_ratings_agent")
  @@index([userId, createdAt], map: "idx_agent_ratings_user")
  @@map("agent_ratings")
}

// Per-pick performance tracking for specialists.
//
// When a specialist emits a pick (sentiment picks "BUY UNI 80%"), we snapshot
// the asset's current USD price + timestamp. A later evaluator job wakes up
// Δt after the pick (e.g. 24h) and scores it: did the price move in the
// direction the specialist predicted? Correct picks boost the specialist's
// marketplace reputation; wrong picks cut it. Over enough cycles, the hire/
// fire rotation (see src/marketplace/hire-fire.ts, planned) prunes consistently
// bad specialists and hires replacements from the marketplace.
//
// See docs/SYSTEM_STATE_AND_FIXES.md Problem 5 for the full design.
model SpecialistPickEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId         String   @map("cycle_id") @db.Uuid
  cycleNumber     Int      @map("cycle_number")
  userId          String   @map("user_id")
  specialistName  String   @map("specialist_name")
  asset           String   // ticker — "WETH", "UNI", etc.
  signal          String   // BUY | SELL | HOLD
  confidence      Int      // 0-100
  reason          String   @db.Text
  entryPriceUsd   Float    @map("entry_price_usd")
  enteredAt       DateTime @default(now()) @map("entered_at") @db.Timestamptz(6)
  // Evaluation fields — populated by pick-evaluator.ts on a delayed tick
  evaluatedAt     DateTime? @map("evaluated_at") @db.Timestamptz(6)
  exitPriceUsd    Float?   @map("exit_price_usd")
  pnlPct          Float?   @map("pnl_pct")
  correct         Boolean? // did the signal direction match the price movement?
  scored          Boolean  @default(false)

  @@index([specialistName, enteredAt], map: "idx_pick_entries_specialist")
  @@index([cycleId], map: "idx_pick_entries_cycle")
  @@index([asset, enteredAt], map: "idx_pick_entries_asset")
  @@index([scored, enteredAt], map: "idx_pick_entries_scored")
  @@map("specialist_pick_entries")
}

model DebateTranscript {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId         String   @map("cycle_id") @db.Uuid
  userId          String   @map("user_id")
  turnNumber      Int      @map("turn_number")
  phase           String   // intelligence, opening, rebuttal, decision, execution
  fromAgent       String   @map("from_agent")
  toAgent         String?  @map("to_agent")
  messageContent  String   @map("message_content")
  responseContent String?  @map("response_content")
  attestationHash String?  @map("attestation_hash")
  teeVerified     Boolean? @default(false) @map("tee_verified")
  durationMs      Int?     @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle           Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, turnNumber], map: "idx_debate_transcripts_cycle_turn")
  @@index([userId, createdAt], map: "idx_debate_transcripts_user")
  @@map("debate_transcripts")
}

model UserHiredAgent {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String          @map("user_id")
  agentId  String          @map("agent_id") @db.Uuid
  hiredAt  DateTime        @default(now()) @map("hired_at") @db.Timestamptz(6)
  active   Boolean         @default(true)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId], map: "idx_user_hired_agents_user")
  @@index([agentId], map: "idx_user_hired_agents_agent")
  @@map("user_hired_agents")
}

model PendingCycle {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id")
  cycleNumber   Int       @map("cycle_number")
  goal          String?   @db.Text
  status        String    @default("PENDING_APPROVAL")
  origin        String    @default("ui")
  specialists   Json      @default("[]")
  debate        Json      @default("{}")
  compactRecord Json      @default("{}") @map("compact_record")
  richRecord    Json?     @map("rich_record")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy    String?   @map("resolved_by")
  modifiedPct   Int?      @map("modified_pct")
  telegramMsgId Int?      @map("telegram_msg_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status], map: "idx_pending_cycles_user_status")
  @@index([expiresAt], map: "idx_pending_cycles_expires")
  @@map("pending_cycles")
}

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  role      String   // "user" | "assistant"
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_chat_messages_user")
  @@map("chat_messages")
}

model NaryoEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        String
  chain         String
  eventType     String            @map("event_type")
  txHash        String?           @map("tx_hash")
  decodedData   Json?             @map("decoded_data")
  rawPayload    Json              @map("raw_payload")
  correlationId String?           @map("correlation_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  correlation   NaryoCorrelation? @relation(fields: [correlationId], references: [id])

  @@index([source, createdAt], map: "idx_naryo_events_source")
  @@index([chain, createdAt], map: "idx_naryo_events_chain")
  @@index([correlationId], map: "idx_naryo_events_correlation")
  @@map("naryo_events")
}

model NaryoCorrelation {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String
  chains      String[]
  proofTxHash String?      @map("proof_tx_hash")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  events      NaryoEvent[]

  @@map("naryo_correlations")
}

// A2 authenticated commerce kernel. These models are additive and deliberately
// separate from the inherited Cannes marketplace tables above.
model AuthChallenge {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message       String    @db.Text
  messageHash   String    @map("message_hash")
  walletAddress String    @map("wallet_address")
  domain        String
  chainId       Int       @map("chain_id")
  action        String
  nonce         String    @unique
  audience      String
  uri           String
  issuedAt      DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([walletAddress, expiresAt], map: "idx_auth_challenges_wallet_expiry")
  @@map("auth_challenges")
}

model AuthSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId   String    @unique @map("challenge_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  walletAddress String    @map("wallet_address")
  userId        String?   @map("user_id")
  action        String
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([walletAddress, expiresAt], map: "idx_auth_sessions_wallet_expiry")
  @@index([userId, expiresAt], map: "idx_auth_sessions_user_expiry")
  @@map("auth_sessions")
}

model KernelAgent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String         @map("owner_user_id")
  name        String
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  versions    AgentVersion[]

  @@unique([ownerUserId, name], map: "uniq_kernel_agents_owner_name")
  @@index([ownerUserId, createdAt], map: "idx_kernel_agents_owner_created")
  @@map("kernel_agents")
}

model AgentVersion {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String      @map("agent_id") @db.Uuid
  version        Int
  manifest       Json
  manifestHash   String      @map("manifest_hash")
  promptHash     String      @map("prompt_hash")
  configHash     String      @map("config_hash")
  capabilities   String[]
  adapterKey     String      @map("adapter_key")
  endpoint       String?
  connectorKey   String?     @map("connector_key")
  ownerWallet    String      @map("owner_wallet")
  payoutAddress  String?     @map("payout_address")
  priceAtomic    BigInt      @map("price_atomic")
  asset          String
  proofPolicy    String      @map("proof_policy")
  lifecycleState String?     @map("lifecycle_state")
  creatorParent  String?     @map("creator_parent")
  agentLabel     String?     @map("agent_label")
  fullSubname    String?     @map("full_subname")
  writePlan      Json?       @map("write_plan")
  writePlanHash  String?     @map("write_plan_hash")
  canonicalState String      @default("UNVERIFIED") @map("canonical_state")
  authorityOwner String?     @map("authority_owner")
  authorityDelegate String?  @map("authority_delegate")
  authorityPolicyVersion String? @map("authority_policy_version")
  authorityRefusal String?   @map("authority_refusal")
  authorityRecordHash String? @map("authority_record_hash")
  authorityObservedAt DateTime? @map("authority_observed_at") @db.Timestamptz(6)
  authorityFreshUntil DateTime? @map("authority_fresh_until") @db.Timestamptz(6)
  authorityReleaseSha String? @map("authority_release_sha")
  published      Boolean     @default(false)
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  agent          KernelAgent @relation(fields: [agentId], references: [id], onDelete: Restrict)
  lifecycleEvents AgentVersionEvent[]
  ensPublicationDecisions EnsPublicationDecision[]
  ensPublicationAuthorityPolicies EnsPublicationAuthorityPolicy[]

  @@unique([agentId, version], map: "uniq_agent_versions_agent_version")
  @@index([published, createdAt], map: "idx_agent_versions_published_created")
  @@map("agent_versions")
}

model AgentVersionEvent {
  id             BigInt       @id @default(autoincrement())
  agentVersionId String       @map("agent_version_id") @db.Uuid
  sequence       Int
  action         String
  payload        Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)

  @@unique([agentVersionId, sequence], map: "uniq_agent_version_events_sequence")
  @@index([agentVersionId, createdAt], map: "idx_agent_version_events_created")
  @@map("agent_version_events")
}

model Quote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId    String   @map("buyer_user_id")
  agentVersionId String   @map("agent_version_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  inputHash      String   @map("input_hash")
  amountAtomic   BigInt   @map("amount_atomic")
  asset          String
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([buyerUserId, idempotencyKey], map: "uniq_quotes_buyer_idempotency")
  @@index([agentVersionId, createdAt], map: "idx_quotes_version_created")
  @@map("quotes")
}

model JobIntent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId    String   @map("buyer_user_id")
  agentVersionId String   @map("agent_version_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  input          Json
  inputHash      String   @map("input_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([buyerUserId, idempotencyKey], map: "uniq_job_intents_buyer_idempotency")
  @@index([agentVersionId, createdAt], map: "idx_job_intents_version_created")
  @@map("job_intents")
}

model Order {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId    String   @map("buyer_user_id")
  agentVersionId String   @map("agent_version_id") @db.Uuid
  intentId       String   @unique @map("intent_id") @db.Uuid
  quoteId        String   @unique @map("quote_id") @db.Uuid
  amountAtomic   BigInt   @map("amount_atomic")
  asset          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([buyerUserId, createdAt], map: "idx_kernel_orders_buyer_created")
  @@map("kernel_orders")
}

model Job {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String    @unique @map("order_id") @db.Uuid
  intentId           String    @unique @map("intent_id") @db.Uuid
  buyerUserId        String    @map("buyer_user_id")
  agentVersionId     String    @map("agent_version_id") @db.Uuid
  state              String    @default("QUEUED")
  version            Int       @default(0)
  attempts           Int       @default(0)
  maxAttempts        Int       @default(3) @map("max_attempts")
  availableAt        DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  cancelRequestedAt  DateTime? @map("cancel_requested_at") @db.Timestamptz(6)
  financialOutcome   String?   @map("financial_outcome")
  lastErrorCode      String?   @map("last_error_code")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([state, availableAt], map: "idx_jobs_state_available")
  @@index([buyerUserId, createdAt], map: "idx_jobs_buyer_created")
  @@map("jobs")
}

model JobEvent {
  id        BigInt   @id @default(autoincrement())
  jobId     String   @map("job_id") @db.Uuid
  version   Int
  eventType String   @map("event_type")
  fromState String?  @map("from_state")
  toState   String   @map("to_state")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([jobId, version], map: "uniq_job_events_job_version")
  @@index([jobId, createdAt], map: "idx_job_events_job_created")
  @@map("job_events")
}

model Effect {
  id             String    @id
  jobId          String    @unique @map("job_id") @db.Uuid
  intentId       String    @unique @map("intent_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  adapterKey     String    @map("adapter_key")
  requestHash    String    @map("request_hash")
  state          String    @default("PENDING")
  attempt        Int       @default(0)
  resultHash     String?   @map("result_hash")
  result         Json?
  errorCode      String?   @map("error_code")
  terminalAt     DateTime? @map("terminal_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("effects")
}

model Receipt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId            String   @unique @map("job_id") @db.Uuid
  effectId         String   @unique @map("effect_id")
  authorityCheckId BigInt   @unique @map("authority_check_id")
  verified         Boolean
  adapterKey       String   @map("adapter_key")
  proofHash        String   @map("proof_hash")
  resultHash       String   @map("result_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("receipts")
}

model Settlement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String   @unique @map("job_id") @db.Uuid
