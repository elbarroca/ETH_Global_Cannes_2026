{
  "name": "alphadawg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/foundation/*.test.ts tests/kernel/state.test.ts",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "test:kernel": "tsx --test tests/kernel/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts tests/a3/*.test.ts tests/a4/*.test.ts && tsx scripts/test-migrations.ts",
    "test:a3": "tsx --test tests/a3/*.test.ts",
    "test:a4": "tsx --test tests/a4/*.test.ts",
    "test:a5": "tsx --test tests/a5/*.test.ts",
    "test:a6": "tsx --test tests/a6/*.test.ts",
    "test:playwright": "npm run build && playwright test",
    "test:go": "cd tools/0g-storage-verifier && go test ./... && go build -o /tmp/alphadawg-0g-storage-verifier ./cmd/verify",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "test:resilience": "tsx --test tests/resilience/*.test.ts",
    "test:redaction": "tsx --test tests/redaction/*.test.ts",
    "test:boot": "ALPHADAWG_RUNTIME_MODE=protected ENABLE_BACKGROUND_WORKERS=false ENABLE_KERNEL_WORKER=false PROTECTED_BOOT_SMOKE=true tsx src/index.ts",
    "clean:generated": "tsx scripts/clean-generated.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "backend": "npx tsx src/index.ts",
    "setup:topic": "npx tsx scripts/setup-topic.ts",
    "setup:token": "npx tsx scripts/setup-token.ts",
    "setup:og": "npx tsx scripts/setup-og-account.ts",
    "setup:hedera-evm": "npx tsx scripts/setup-hedera-evm.ts",
    "deploy:naryo": "./node_modules/.bin/hardhat compile && npx tsx scripts/deploy-naryo-contract.ts",
    "naryo:up": "cd naryo && docker compose up -d",
    "naryo:down": "cd naryo && docker compose down",
    "naryo:logs": "cd naryo && docker compose logs -f naryo-server",
    "validate": "npx tsx scripts/validate-all.ts",
    "validate:approval": "npx tsx scripts/validate-approval-flow.ts",
    "migrate": "prisma migrate deploy",
    "setup:circle": "npx tsx scripts/setup-circle.ts",
    "specialists": "tsx src/agents/specialist-server.ts",
    "bot": "node --env-file=.env.local --import tsx --eval \"import('./src/telegram/bot.ts').then(({ startBot }) => startBot())\"",
    "cycle": "tsx src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "setup:webhook": "npx tsx scripts/set-telegram-webhook.ts",
    "deploy:arc-swap": "./node_modules/.bin/hardhat compile && npx tsx scripts/deploy-arc-swap-router.ts",
    "backfill:inft": "npx tsx scripts/backfill-inft.ts",
    "mint:specialist-infts": "npx tsx scripts/mint-specialist-infts.ts",
    "store:specialist-memory": "npx tsx scripts/store-specialist-memory.ts",
    "demo:auto-approve": "npx tsx scripts/set-demo-auto-approve.ts",
    "setup:specialist-wallets": "npx tsx scripts/assign-specialist-wallets.ts",
    "setup:icons": "npx tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "1.2.8",
    "@0glabs/0g-serving-broker": "0.7.8",
    "@circle-fin/developer-controlled-wallets": "^10.2.0",
    "@circle-fin/x402-batching": "^2.0.4",
    "@hashgraph/sdk": "^2.69.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.96.2",
    "@types/crypto-js": "4.2.2",
    "@x402/core": "*",
    "@x402/evm": "*",
    "@x402/express": "*",
    "@x402/fetch": "*",
    "crypto-js": "4.2.0",
    "dotenv": "*",
    "ethers": "6.17.0",
    "express": "4.22.2",
    "motion": "12.42.2",
    "next": "16.2.11",
    "node-telegram-bot-api": "0.67.0",
    "postgres": "^3.4.8",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.47.6",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/express": "*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/node-telegram-bot-api": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^4.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^1.0.10",
    "sharp": "0.35.3",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "*",
    "typechain": "^8.3.2",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "adm-zip": "0.6.0",
    "axios": "1.18.1",
    "ethers": "6.17.0",
    "fast-uri": "4.1.1",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "postcss": "8.5.23",
    "protobufjs": "8.7.1",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  }
}
